# Public application URL used in room links and canonical production configuration.
VITE_PUBLIC_APP_URL=https://gamibar.com

# Supabase public browser credentials. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional search-engine ownership verification tokens.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Optional analytics. Scripts are omitted entirely when these values are blank.
VITE_GA_MEASUREMENT_ID=
VITE_MICROSOFT_CLARITY_ID=

